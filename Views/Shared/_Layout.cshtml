@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controllerName)
    {
        return string.Equals(controller, controllerName, StringComparison.OrdinalIgnoreCase);
    }

    bool IsHomeActive()
    {
        return string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
            && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    }

    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    string userName = User.Identity?.Name ?? "Пользователь";
    string userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

    bool isAdministrator = User.IsInRole("Administrator");

    bool canViewDashboard = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicies.DashboardView)).Succeeded;
    bool canViewClients = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicies.ClientsView)).Succeeded;
    bool canViewProducts = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicies.ProductsView)).Succeeded;
    bool canViewOffers = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicies.OffersView)).Succeeded;
    bool canViewContracts = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicies.ContractsView)).Succeeded;
    bool canViewDeals = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicies.DealsView)).Succeeded;
    bool canManageUsers = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicies.UsersManage)).Succeeded;
    bool canViewAudit = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicies.AuditView)).Succeeded;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Contractor Hub</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/users.css"
          asp-append-version="true" />
</head>

<body>

    <header class="hub-header">

        <nav class="hub-navbar">

            <div class="hub-nav-container">

                @if (canViewDashboard)
                {
                    <a class="hub-brand"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="hub-brand-mark">
                            <i class="fas fa-building"></i>
                        </span>

                        <span class="hub-brand-text">
                            <strong>Contractor</strong>
                            <span>Hub</span>
                        </span>

                    </a>
                }
                else
                {
                    <div class="hub-brand" aria-label="Contractor Hub">
                        <span class="hub-brand-mark">
                            <i class="fas fa-building"></i>
                        </span>

                        <span class="hub-brand-text">
                            <strong>Contractor</strong>
                            <span>Hub</span>
                        </span>
                    </div>
                }

                <button class="hub-nav-toggle"
                        type="button"
                        id="hubNavToggle"
                        aria-controls="contractorNavigation"
                        aria-expanded="false"
                        aria-label="Открыть меню">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>

                <div class="hub-nav-overlay" id="hubNavOverlay"></div>

                <div class="hub-nav-collapse" id="contractorNavigation">

                    <div class="hub-sidebar-heading">
                        <span>НАВИГАЦИЯ</span>

                        <button type="button"
                                class="hub-sidebar-close"
                                id="hubNavClose"
                                aria-label="Закрыть меню">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>

                    <div class="hub-nav-main">

                        @if (canViewDashboard)
                        {
                            <a class="hub-nav-link @(IsHomeActive() ? "active" : "")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="fas fa-grid-2"></i>
                                <span>Рабочий стол</span>

                            </a>
                        }

                        @if (canViewClients)
                        {
                            <a class="hub-nav-link @(IsActive("Clients") ? "active" : "")"
                               asp-area=""
                               asp-controller="Clients"
                               asp-action="Index">

                                <i class="fas fa-users"></i>
                                <span>Клиенты</span>

                            </a>
                        }

                        @if (canViewProducts)
                        {
                            <a class="hub-nav-link @(IsActive("Products") ? "active" : "")"
                               asp-area=""
                               asp-controller="Products"
                               asp-action="Index">

                                <i class="fas fa-box"></i>
                                <span>Товары</span>

                            </a>
                        }

                        @if (canViewOffers)
                        {
                            <a class="hub-nav-link @(IsActive("CommercialOffers") ? "active" : "")"
                               asp-area=""
                               asp-controller="CommercialOffers"
                               asp-action="Index">

                                <i class="fas fa-file-lines"></i>
                                <span>Коммерческие предложения</span>

                            </a>
                        }

                        @if (canViewContracts)
                        {
                            <a class="hub-nav-link @(IsActive("Contracts") ? "active" : "")"
                               asp-area=""
                               asp-controller="Contracts"
                               asp-action="Index">

                                <i class="fas fa-file-contract"></i>
                                <span>Договоры</span>

                            </a>
                        }


                        @if (canViewDeals)
                        {
                            <a class="hub-nav-link @(IsActive("Deals") ? "active" : "")" asp-area="" asp-controller="Deals" asp-action="Index">
                                <i class="fas fa-handshake"></i>
                                <span>Сделки</span>
                            </a>
                        }
                    </div>

                    <div class="hub-nav-secondary">

                        @if (canViewDashboard)
                        {
                            <a class="hub-nav-link hub-nav-link-secondary @(IsActive("Dashboard") ? "active" : "")"
                               asp-area=""
                               asp-controller="Dashboard"
                               asp-action="Index"
                               title="Статистика">

                                <i class="fas fa-chart-simple"></i>
                                <span>Статистика</span>

                            </a>
                        }

                        @if (canManageUsers)
                        {
                            <a class="hub-nav-link hub-nav-link-secondary @(IsActive("Users") ? "active" : "")"
                               asp-area=""
                               asp-controller="Users"
                               asp-action="Index"
                               title="Сотрудники">

                                <i class="fas fa-user-shield"></i>
                                <span>Сотрудники</span>

                            </a>
                        }

                        @if (isAdministrator)
                        {
                            <a class="hub-nav-link hub-nav-link-secondary @(IsActive("Permissions") ? "active" : "")"
                               asp-area=""
                               asp-controller="Permissions"
                               asp-action="Index"
                               title="Права доступа">

                                <i class="fas fa-key"></i>
                                <span>Права доступа</span>

                            </a>
                        }

                        @if (canViewAudit)
                        {
                            <a class="hub-nav-link hub-nav-link-secondary @(IsActive("Audit") ? "active" : "")"
                               asp-area=""
                               asp-controller="Audit"
                               asp-action="Index"
                               title="Журнал активности">

                                <i class="fas fa-clock-rotate-left"></i>
                                <span>Журнал активности</span>

                            </a>
                        }
                        @if (canViewDashboard)
                        {
                        <div class="dropdown hub-system-menu">

                            <button class="hub-nav-system-button dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="hub-system-avatar">
                                    <i class="fas fa-sliders"></i>
                                </span>

                                <span>Система</span>

                            </button>

                            <ul class="dropdown-menu hub-system-dropdown">

                                <li class="hub-dropdown-heading">
                                    <span>Система</span>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Home"
                                       asp-action="About">

                                        <i class="fas fa-circle-info"></i>
                                        <span>О проекте</span>

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Home"
                                       asp-action="Privacy">

                                        <i class="fas fa-shield-halved"></i>
                                        <span>Конфиденциальность</span>

                                    </a>
                                </li>

                            </ul>

                        </div>
                        }

                        @if (isAuthenticated)
                        {
                            <div class="dropdown hub-user-menu">

                                <button class="hub-nav-user-button dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="hub-user-avatar">
                                        <i class="fas fa-user"></i>
                                    </span>

                                    <span class="hub-user-info">
                                        <strong>@userName</strong>

                                        @if (!string.IsNullOrWhiteSpace(userRole))
                                        {
                                            <small>@userRole</small>
                                        }
                                    </span>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end hub-user-dropdown">

                                    <li class="hub-dropdown-heading">
                                        <span>Профиль</span>
                                    </li>

                                    <li>
                                        <div class="hub-user-dropdown-info">

                                            <span class="hub-user-dropdown-avatar">
                                                <i class="fas fa-user"></i>
                                            </span>

                                            <div>
                                                <strong>@userName</strong>
                                                <small>@userRole</small>
                                            </div>

                                        </div>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item hub-logout-button">

                                                <i class="fas fa-right-from-bracket"></i>
                                                <span>Выйти</span>

                                            </button>

                                        </form>
                                    </li>

                                </ul>

                            </div>
                        }
                        else
                        {
                            <a class="hub-login-button"
                               asp-controller="Account"
                               asp-action="Login">

                                <i class="fas fa-right-to-bracket"></i>
                                <span>Войти</span>

                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <div class="hub-page-container">

        <main role="main" class="hub-main-content">

            @RenderBody()

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.map(function (el) {
                return new bootstrap.Tooltip(el);
            });

        });
                const navToggle = document.getElementById('hubNavToggle');
        const navClose = document.getElementById('hubNavClose');
        const navPanel = document.getElementById('contractorNavigation');
        const navOverlay = document.getElementById('hubNavOverlay');

        function openNav() {
            navPanel.classList.add('is-open');
            navOverlay.classList.add('is-visible');
            navToggle.setAttribute('aria-expanded', 'true');
            document.body.classList.add('hub-nav-open');
        }

        function closeNav() {
            navPanel.classList.remove('is-open');
            navOverlay.classList.remove('is-visible');
            navToggle.setAttribute('aria-expanded', 'false');
            document.body.classList.remove('hub-nav-open');
        }

        navToggle.addEventListener('click', function () {
            if (navPanel.classList.contains('is-open')) {
                closeNav();
            } else {
                openNav();
            }
        });

        navClose.addEventListener('click', closeNav);
        navOverlay.addEventListener('click', closeNav);

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeNav();
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>