@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controllerName)
    {
        return string.Equals(controller, controllerName, StringComparison.OrdinalIgnoreCase);
    }

    bool IsHomeActive()
    {
        return string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
            && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    }
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Contractor Hub</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="hub-header">

        <nav class="hub-navbar">

            <div class="hub-nav-container">

                <a class="hub-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="hub-brand-mark">
                        <i class="fas fa-building"></i>
                    </span>

                    <span class="hub-brand-text">
                        <strong>Contractor</strong>
                        <span>Hub</span>
                    </span>

                </a>

                <button class="hub-nav-toggle"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#contractorNavigation"
                        aria-controls="contractorNavigation"
                        aria-expanded="false"
                        aria-label="Открыть меню">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>

                <div class="collapse hub-nav-collapse"
                     id="contractorNavigation">

                    <div class="hub-nav-main">

                        <a class="hub-nav-link @(IsHomeActive() ? "active" : "")"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="fas fa-grid-2"></i>
                            <span>Рабочий стол</span>

                        </a>

                        <a class="hub-nav-link @(IsActive("Clients") ? "active" : "")"
                           asp-area=""
                           asp-controller="Clients"
                           asp-action="Index">

                            <i class="fas fa-users"></i>
                            <span>Клиенты</span>

                        </a>

                        <a class="hub-nav-link @(IsActive("Products") ? "active" : "")"
                           asp-area=""
                           asp-controller="Products"
                           asp-action="Index">

                            <i class="fas fa-box"></i>
                            <span>Товары</span>

                        </a>

                        <a class="hub-nav-link @(IsActive("CommercialOffers") ? "active" : "")"
                           asp-area=""
                           asp-controller="CommercialOffers"
                           asp-action="Index">

                            <i class="fas fa-file-lines"></i>
                            <span>Коммерческие предложения</span>

                        </a>

                        <a class="hub-nav-link @(IsActive("Contracts") ? "active" : "")"
                           asp-area=""
                           asp-controller="Contracts"
                           asp-action="Index">

                            <i class="fas fa-file-contract"></i>
                            <span>Договоры</span>

                        </a>

                    </div>

                    <div class="hub-nav-secondary">

                        <a class="hub-nav-link hub-nav-link-secondary @(IsActive("Dashboard") ? "active" : "")"
                           asp-area=""
                           asp-controller="Dashboard"
                           asp-action="Index"
                           title="Статистика">

                            <i class="fas fa-chart-simple"></i>
                            <span>Статистика</span>

                        </a>

                        <div class="dropdown hub-system-menu">

                            <button class="hub-nav-system-button dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="hub-system-avatar">
                                    <i class="fas fa-sliders"></i>
                                </span>

                                <span>Система</span>

                            </button>

                            <ul class="dropdown-menu hub-system-dropdown">

                                <li class="hub-dropdown-heading">
                                    <span>Система</span>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Home"
                                       asp-action="About">

                                        <i class="fas fa-circle-info"></i>
                                        <span>О проекте</span>

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Home"
                                       asp-action="Privacy">

                                        <i class="fas fa-shield-halved"></i>
                                        <span>Конфиденциальность</span>

                                    </a>
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <div class="hub-page-container">

        <main role="main" class="hub-main-content">

            @RenderBody()

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.map(function (el) {
                return new bootstrap.Tooltip(el);
            });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>