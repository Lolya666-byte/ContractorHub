@{
    ViewData["Title"] = "Вход";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Вход — Contractor Hub</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <style>
        :root {
            --login-bg: #f5f3ed;
            --login-paper: rgba(255, 255, 255, 0.58);
            --login-ink: #1a1a1e;
            --login-blue: #1a3a5c;
            --login-muted: #7a8491;
            --login-line: rgba(26, 26, 30, 0.10);
            --login-orange: #b85c3a;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 36px 24px;
            background: radial-gradient( circle at 12% 15%, rgba(184, 92, 58, 0.055), transparent 30% ), var(--login-bg);
            color: var(--login-ink);
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button,
        input {
            font: inherit;
        }

        .login-shell {
            width: 100%;
            max-width: 940px;
        }

        .login-topline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 18px;
        }

        .login-brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            color: var(--login-ink);
            text-decoration: none;
        }

        .login-brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            background: var(--login-blue);
            color: #fff;
            font-size: 15px;
        }

        .login-brand-name {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.7px;
        }

            .login-brand-name span {
                color: var(--login-muted);
                font-weight: 500;
            }

        .login-top-label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--login-muted);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .login-top-dot {
            width: 7px;
            height: 7px;
            background: #3a6a4a;
            border-radius: 50%;
        }

        .login-layout {
            display: grid;
            grid-template-columns: 0.92fr 1.08fr;
            min-height: 490px;
            background: var(--login-paper);
            border: 1px solid rgba(255, 255, 255, 0.82);
            box-shadow: 0 18px 55px rgba(26, 26, 30, 0.045), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        }

        .login-intro {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            padding: 42px 38px;
            background: rgba(26, 58, 92, 0.045);
            border-right: 1px solid var(--login-line);
        }

            .login-intro::after {
                content: "";
                position: absolute;
                right: -76px;
                bottom: -100px;
                width: 250px;
                height: 250px;
                border: 1px solid rgba(26, 58, 92, 0.10);
                transform: rotate(35deg);
                pointer-events: none;
            }

        .login-eyebrow {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 23px;
            color: var(--login-orange);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .login-eyebrow-line {
            width: 20px;
            height: 2px;
            background: var(--login-orange);
        }

        .login-intro h1 {
            max-width: 340px;
            margin: 0;
            color: var(--login-ink);
            font-size: clamp(2rem, 4vw, 2.75rem);
            font-weight: 800;
            line-height: 1.04;
            letter-spacing: -2px;
        }

        .login-intro-text {
            max-width: 320px;
            margin: 19px 0 0;
            color: var(--login-muted);
            font-size: 0.82rem;
            line-height: 1.8;
        }

        .login-feature-list {
            display: grid;
            gap: 17px;
            margin-top: 38px;
        }

        .login-feature {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #4f5965;
            font-size: 0.72rem;
            font-weight: 500;
        }

        .login-feature-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            background: rgba(26, 58, 92, 0.07);
            color: var(--login-blue);
            font-size: 12px;
        }

        .login-intro-footer {
            position: relative;
            z-index: 1;
            margin-top: 42px;
            padding-top: 17px;
            border-top: 1px solid var(--login-line);
            color: #89919a;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .login-form-area {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 48px clamp(28px, 5vw, 58px);
        }

        .login-form-kicker {
            margin-bottom: 10px;
            color: var(--login-orange);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .login-form-area h2 {
            margin: 0;
            color: var(--login-ink);
            font-size: 1.75rem;
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -1px;
        }

        .login-description {
            margin: 11px 0 28px;
            color: var(--login-muted);
            font-size: 0.76rem;
            line-height: 1.65;
        }

        .login-error {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 20px;
            padding: 12px 14px;
            border: 1px solid rgba(184, 92, 58, 0.18);
            background: rgba(184, 92, 58, 0.06);
            color: #91472f;
            font-size: 0.72rem;
            line-height: 1.55;
        }

            .login-error i {
                margin-top: 2px;
            }

        .login-field {
            margin-bottom: 19px;
        }

            .login-field label {
                display: block;
                margin-bottom: 8px;
                color: #525b66;
                font-size: 0.7rem;
                font-weight: 700;
            }

        .login-input-wrap {
            position: relative;
        }

            .login-input-wrap > i {
                position: absolute;
                top: 50%;
                left: 14px;
                transform: translateY(-50%);
                color: #8b939c;
                font-size: 0.78rem;
                pointer-events: none;
            }

        .login-input {
            display: block;
            width: 100%;
            height: 46px;
            padding: 0 14px 0 40px;
            border: 1px solid rgba(26, 26, 30, 0.12);
            border-radius: 0;
            outline: none;
            background: rgba(255, 255, 255, 0.52);
            color: var(--login-ink);
            font-size: 0.78rem;
            transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
        }

            .login-input::placeholder {
                color: #a0a6ad;
            }

            .login-input:focus {
                border-color: rgba(26, 58, 92, 0.42);
                background: rgba(255, 255, 255, 0.88);
                box-shadow: 0 0 0 3px rgba(26, 58, 92, 0.055);
            }

        .login-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            min-height: 46px;
            margin-top: 7px;
            padding: 0 18px;
            border: 0;
            border-radius: 0;
            background: var(--login-blue);
            color: #fff;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            cursor: pointer;
            box-shadow: 4px 4px 0 rgba(26, 58, 92, 0.10);
            transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
        }

            .login-button:hover {
                background: #214e79;
                transform: translate(-1px, -1px);
                box-shadow: 6px 6px 0 rgba(26, 58, 92, 0.11);
            }

            .login-button:focus-visible {
                outline: 3px solid rgba(26, 58, 92, 0.25);
                outline-offset: 3px;
            }

        .login-form-note {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin-top: 23px;
            padding-top: 17px;
            border-top: 1px solid var(--login-line);
            color: #858d96;
            font-size: 0.64rem;
            line-height: 1.6;
        }

            .login-form-note i {
                margin-top: 2px;
                color: var(--login-blue);
            }

        .login-bottom {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            margin-top: 17px;
            color: #9299a1;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        @@media (max-width: 700px) {
            body

        {
            align-items: flex-start;
            padding: 22px 14px;
        }

        .login-topline {
            margin-bottom: 14px;
        }

        .login-top-label {
            font-size: 8px;
            letter-spacing: 0.7px;
        }

        .login-brand-name {
            font-size: 15px;
        }

        .login-layout {
            grid-template-columns: 1fr;
        }

        .login-intro {
            padding: 28px 25px;
            border-right: 0;
            border-bottom: 1px solid var(--login-line);
        }

            .login-intro h1 {
                font-size: 2rem;
                letter-spacing: -1.4px;
            }

        .login-intro-text {
            margin-top: 12px;
        }

        .login-feature-list {
            grid-template-columns: 1fr;
            gap: 10px;
            margin-top: 23px;
        }

        .login-feature-icon {
            width: 30px;
            height: 30px;
            flex-basis: 30px;
        }

        .login-intro-footer {
            margin-top: 25px;
        }

        .login-form-area {
            padding: 32px 25px;
        }

        .login-bottom {
            flex-direction: column;
            gap: 7px;
        }

        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after

        {
            transition: none !important;
        }

        }
    </style>
</head>

<body>
    <div class="login-shell">

        <div class="login-topline">
            <div class="login-brand">
                <span class="login-brand-mark">
                    <i class="fas fa-building"></i>
                </span>

                <span class="login-brand-name">
                    Contractor <span>Hub</span>
                </span>
            </div>

            <div class="login-top-label">
                <span class="login-top-dot"></span>
                Рабочая система
            </div>
        </div>

        <div class="login-layout">

            <section class="login-intro">
                <div>
                    <div class="login-eyebrow">
                        <span class="login-eyebrow-line"></span>
                        Contractor Hub
                    </div>

                    <h1>Всё для работы с клиентами — в одном месте.</h1>

                    <p class="login-intro-text">
                        Единое рабочее пространство для управления клиентами,
                        товарами, коммерческими предложениями и договорами.
                    </p>

                    <div class="login-feature-list">
                        <div class="login-feature">
                            <span class="login-feature-icon">
                                <i class="fas fa-users"></i>
                            </span>
                            <span>Клиентская база и рабочие процессы</span>
                        </div>

                        <div class="login-feature">
                            <span class="login-feature-icon">
                                <i class="fas fa-file-lines"></i>
                            </span>
                            <span>Коммерческие предложения и документы</span>
                        </div>

                        <div class="login-feature">
                            <span class="login-feature-icon">
                                <i class="fas fa-chart-simple"></i>
                            </span>
                            <span>Статистика и контроль работы</span>
                        </div>
                    </div>
                </div>

                <div class="login-intro-footer">
                    Система управления рабочими процессами
                </div>
            </section>

            <section class="login-form-area">
                <div class="login-form-kicker">Авторизация сотрудника</div>

                <h2>Вход в систему</h2>

                <p class="login-description">
                    Введите свои учётные данные, чтобы продолжить работу.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="login-error" role="alert">
                        <i class="fas fa-circle-exclamation"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewBag.ReturnUrl" />

                    <div class="login-field">
                        <label for="username">Логин</label>

                        <div class="login-input-wrap">
                            <i class="fas fa-user"></i>

                            <input id="username"
                                   name="username"
                                   type="text"
                                   class="login-input"
                                   autocomplete="username"
                                   placeholder="Введите логин"
                                   required />
                        </div>
                    </div>

                    <div class="login-field">
                        <label for="password">Пароль</label>

                        <div class="login-input-wrap">
                            <i class="fas fa-lock"></i>

                            <input id="password"
                                   name="password"
                                   type="password"
                                   class="login-input"
                                   autocomplete="current-password"
                                   placeholder="Введите пароль"
                                   required />
                        </div>
                    </div>

                    <button type="submit" class="login-button">
                        <span>Войти в систему</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>

                </form>

                <div class="login-form-note">
                    <i class="fas fa-shield-halved"></i>
                    <span>
                        Доступ к системе предоставляется сотрудникам
                        в соответствии с назначенными правами.
                    </span>
                </div>
            </section>

        </div>

        <div class="login-bottom">
            <span>Contractor Hub</span>
            <span>Рабочая панель управления</span>
        </div>

    </div>
</body>
</html>