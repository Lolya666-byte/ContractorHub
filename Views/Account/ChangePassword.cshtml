@{
    ViewData["Title"] = "Смена пароля";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Смена пароля — Contractor Hub</title>

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background: #f5efe6;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .password-wrapper {
            width: 460px;
            max-width: calc(100% - 40px);
        }

        .brand {
            text-align: center;
            margin-bottom: 25px;
        }

        .brand-title {
            font-size: 31px;
            font-weight: 800;
            color: #1d3557;
        }

        .brand-subtitle {
            margin-top: 6px;
            color: #777;
            font-size: 13px;
        }

        .card {
            background: #fff;
            border-radius: 18px;
            padding: 34px;
            box-shadow: 0 15px 45px rgba(0,0,0,.08);
        }

        h1 {
            margin: 0 0 9px;
            color: #222;
            font-size: 25px;
        }

        .description {
            margin: 0 0 24px;
            color: #777;
            font-size: 14px;
            line-height: 1.5;
        }

        .notice,
        .error {
            padding: 12px 14px;
            border-radius: 9px;
            margin-bottom: 18px;
            font-size: 13px;
            line-height: 1.45;
        }

        .notice {
            background: #eef5fb;
            color: #1d3557;
        }

        .error {
            background: #fff0ed;
            color: #b6422d;
        }

        .form-group {
            margin-bottom: 17px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            color: #333;
            font-size: 13px;
            font-weight: 700;
        }

        input {
            width: 100%;
            height: 46px;
            padding: 0 14px;
            border: 1px solid #ddd4c8;
            border-radius: 10px;
            outline: none;
            font-size: 14px;
        }

        input:focus {
            border-color: #e88932;
            box-shadow: 0 0 0 3px rgba(232,137,50,.10);
        }

        .hint {
            margin-top: 7px;
            color: #8a8f97;
            font-size: 11px;
            line-height: 1.45;
        }

        .requirements {
            padding: 13px 14px;
            margin: 3px 0 20px;
            border-radius: 10px;
            background: #f8f5ef;
            color: #707780;
            font-size: 12px;
            line-height: 1.55;
        }

        .actions {
            display: flex;
            gap: 10px;
            margin-top: 23px;
        }

        .button,
        .cancel {
            height: 46px;
            flex: 1;
            border: none;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        .button {
            background: #e88932;
            color: #fff;
        }

        .button:hover { background: #d97620; }

        .cancel {
            background: #f2f1ef;
            color: #555b64;
        }
    </style>
</head>

<body>
<div class="password-wrapper">

    <div class="brand">
        <div class="brand-title">Contractor Hub</div>
        <div class="brand-subtitle">Безопасность учётной записи</div>
    </div>

    <div class="card">
        <h1>Смена пароля</h1>

        <p class="description">
            Установите новый пароль для своей учётной записи.
        </p>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Notice))
        {
            <div class="notice">@ViewBag.Notice</div>
        }

        @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
        {
            <div class="error">@ViewBag.Error</div>
        }

        <div class="requirements">
            Новый пароль должен содержать минимум 8 символов,
            заглавную букву, строчную букву и цифру.
        </div>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="currentPassword">Текущий пароль</label>
                <input id="currentPassword"
                       name="currentPassword"
                       type="password"
                       autocomplete="current-password"
                       required />
            </div>

            <div class="form-group">
                <label for="newPassword">Новый пароль</label>
                <input id="newPassword"
                       name="newPassword"
                       type="password"
                       minlength="8"
                       autocomplete="new-password"
                       required />
                <div class="hint">
                    Не используйте очевидные пароли вроде 12345678 или password.
                </div>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Повторите новый пароль</label>
                <input id="confirmPassword"
                       name="confirmPassword"
                       type="password"
                       minlength="8"
                       autocomplete="new-password"
                       required />
            </div>

            <div class="actions">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="cancel">
                    Отмена
                </a>

                <button type="submit" class="button">
                    Сохранить пароль
                </button>
            </div>
        </form>
    </div>
</div>
</body>
</html>
