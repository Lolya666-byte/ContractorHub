@{
    ViewData["Title"] = "О проекте";
}

<div class="system-page">

    <section class="system-header">

        <div>
            <div class="system-eyebrow">
                CONTRACTOR HUB
            </div>

            <h1>О проекте</h1>

            <p>
                Рабочее пространство для управления клиентами,
                товарами, коммерческими предложениями и договорами.
            </p>
        </div>

        <div class="system-header-mark">
            <i class="fas fa-layer-group"></i>
        </div>

    </section>

    <section class="about-hero">

        <div class="about-hero-main">

            <span class="about-kicker">
                B2B WORKSPACE
            </span>

            <h2>
                От клиента до подписанного договора —
                в одном месте.
            </h2>

            <p>
                Contractor Hub объединяет основные рабочие процессы компании
                в единую систему: данные клиентов и товаров используются
                при подготовке коммерческих предложений, а согласованные КП
                становятся основанием для формирования договоров.
            </p>

        </div>

        <div class="about-hero-side">

            <div class="about-flow-item">
                <span>01</span>
                <strong>Клиент</strong>
                <small>Контрагенты и реквизиты</small>
            </div>

            <div class="about-flow-arrow">
                <i class="fas fa-arrow-down"></i>
            </div>

            <div class="about-flow-item">
                <span>02</span>
                <strong>КП</strong>
                <small>Товары, цены и условия</small>
            </div>

            <div class="about-flow-arrow">
                <i class="fas fa-arrow-down"></i>
            </div>

            <div class="about-flow-item">
                <span>03</span>
                <strong>Договор</strong>
                <small>Статус и PDF-документ</small>
            </div>

        </div>

    </section>

    <section class="system-section">

        <div class="system-section-heading">

            <div>
                <span class="system-section-kicker">
                    01 / РАЗДЕЛЫ
                </span>

                <h2>Что умеет система</h2>
            </div>

            <span class="system-section-note">
                Основные рабочие инструменты
            </span>

        </div>


        <div class="about-modules">

            <article class="about-module">

                <div class="about-module-icon">
                    <i class="fas fa-users"></i>
                </div>

                <div>
                    <span class="about-module-number">01</span>

                    <h3>Клиенты</h3>

                    <p>
                        Единый справочник контрагентов с контактными
                        данными и реквизитами.
                    </p>
                </div>

            </article>


            <article class="about-module">

                <div class="about-module-icon">
                    <i class="fas fa-box"></i>
                </div>

                <div>
                    <span class="about-module-number">02</span>

                    <h3>Товары</h3>

                    <p>
                        Каталог товаров, цены и остатки,
                        используемые при подготовке КП.
                    </p>
                </div>

            </article>


            <article class="about-module">

                <div class="about-module-icon">
                    <i class="fas fa-file-lines"></i>
                </div>

                <div>
                    <span class="about-module-number">03</span>

                    <h3>Коммерческие предложения</h3>

                    <p>
                        Формирование КП из клиента и товаров,
                        автоматические расчёты и управление статусом.
                    </p>
                </div>

            </article>


            <article class="about-module">

                <div class="about-module-icon">
                    <i class="fas fa-file-contract"></i>
                </div>

                <div>
                    <span class="about-module-number">04</span>

                    <h3>Договоры</h3>

                    <p>
                        Формируются из коммерческих предложений,
                        проходят собственный цикл статусов и доступны в PDF.
                    </p>

                </div>

            </article>


            <article class="about-module">

                <div class="about-module-icon">
                    <i class="fas fa-chart-column"></i>
                </div>

                <div>
                    <span class="about-module-number">05</span>

                    <h3>Статистика</h3>

                    <p>
                        Обзор количества КП и договоров, финансовых показателей
                        и основных клиентов.
                    </p>

                </div>

            </article>

        </div>

    </section>

    <section class="system-section">

        <div class="system-section-heading">

            <div>
                <span class="system-section-kicker">
                    02 / ЛОГИКА
                </span>

                <h2>Система работает вокруг одного процесса</h2>
            </div>

        </div>


        <div class="about-logic">

            <div class="about-logic-line"></div>


            <div class="about-logic-item">

                <span class="about-logic-index">01</span>

                <div>
                    <strong>Создать клиента</strong>

                    <p>
                        Добавить организацию или контакт,
                        с которым ведётся работа.
                    </p>
                </div>

            </div>


            <div class="about-logic-item">

                <span class="about-logic-index">02</span>

                <div>
                    <strong>Подготовить КП</strong>

                    <p>
                        Выбрать клиента и товары,
                        после чего система рассчитает предложение.
                    </p>
                </div>

            </div>


            <div class="about-logic-item">

                <span class="about-logic-index">03</span>

                <div>
                    <strong>Сформировать договор</strong>

                    <p>
                        После согласования коммерческого предложения
                        создаётся договор.
                    </p>
                </div>

            </div>


            <div class="about-logic-item">

                <span class="about-logic-index">04</span>

                <div>
                    <strong>Закрыть цикл</strong>

                    <p>
                        Договор получает актуальный статус,
                        а документ можно скачать в PDF.
                    </p>
                </div>

            </div>

        </div>

    </section>

    <section class="system-section">

        <div class="system-section-heading">

            <div>
                <span class="system-section-kicker">
                    03 / ТЕХНОЛОГИИ
                </span>

                <h2>На чём построен Contractor Hub</h2>
            </div>

        </div>


        <div class="about-tech">

            <div class="about-tech-item">
                <strong>ASP.NET Core 8</strong>
                <span>Веб-приложение</span>
            </div>

            <div class="about-tech-item">
                <strong>Entity Framework Core</strong>
                <span>Работа с данными</span>
            </div>

            <div class="about-tech-item">
                <strong>SQLite</strong>
                <span>Хранение данных</span>
            </div>

            <div class="about-tech-item">
                <strong>Chart.js</strong>
                <span>Визуализация статистики</span>
            </div>

            <div class="about-tech-item">
                <strong>QuestPDF</strong>
                <span>Формирование документов</span>
            </div>

            <div class="about-tech-item">
                <strong>Font Awesome</strong>
                <span>Иконки интерфейса</span>
            </div>

        </div>

    </section>


    <div class="system-page-footer">

        <a asp-controller="Home"
           asp-action="Index"
           class="system-back-button">

            <i class="fas fa-arrow-left"></i>

            На главную

        </a>

    </div>

</div>
