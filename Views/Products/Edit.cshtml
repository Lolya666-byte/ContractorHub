@model ContractorHub.Models.Product

@{
    ViewData["Title"] = "Редактирование товара";
}

<div class="product-form-page">

    <section class="product-form-header">

        <div>
            <div class="product-form-eyebrow">
                КАТАЛОГ ТОВАРОВ
            </div>

            <h1>Редактирование товара</h1>

            <p>
                Обновите информацию, стоимость или остаток товара.
            </p>
        </div>

        <a asp-action="Index"
           class="product-form-back">
            <i class="fas fa-arrow-left"></i>
            К товарам
        </a>

    </section>

    <section class="product-form-layout">

        <form method="post"
              asp-action="Edit"
              class="product-form-card">

            <input type="hidden" asp-for="Id" />

            <div class="product-form-section">

                <div class="product-form-section-header">

                    <div>
                        <span class="product-form-kicker">01</span>
                        <h2>Основная информация</h2>
                    </div>

                    <i class="fas fa-box product-form-section-icon"></i>

                </div>


                <div class="product-form-grid">

                    <div class="product-form-field product-form-field-wide">

                        <label asp-for="Name">
                            Название товара
                            <span class="product-required">*</span>
                        </label>

                        <input asp-for="Name"
                               class="product-input"
                               placeholder="Например, Кабель ВВГнг 3×2.5"
                               autofocus />

                        <span asp-validation-for="Name"
                              class="product-validation"></span>

                    </div>


                    <div class="product-form-field">

                        <label asp-for="Category">
                            Категория
                        </label>

                        <input asp-for="Category"
                               class="product-input"
                               placeholder="Электрика" />

                        <span class="product-field-hint">
                            Категория помогает быстро находить товар в каталоге.
                        </span>

                        <span asp-validation-for="Category"
                              class="product-validation"></span>

                    </div>

                </div>

            </div>

            <div class="product-form-section">

                <div class="product-form-section-header">

                    <div>
                        <span class="product-form-kicker">02</span>
                        <h2>Цена и наличие</h2>
                    </div>

                    <i class="fas fa-chart-line product-form-section-icon"></i>

                </div>


                <div class="product-form-grid">

                    <div class="product-form-field">

                        <label asp-for="Price">
                            Цена
                            <span class="product-required">*</span>
                        </label>

                        <div class="product-input-with-suffix">
                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="product-input"
                                   placeholder="0.00"
                                   inputmode="decimal" />

                            <span>₽</span>
                        </div>

                        <span class="product-field-hint">
                            Стоимость одной единицы товара.
                        </span>

                        <span asp-validation-for="Price"
                              class="product-validation"></span>

                    </div>


                    <div class="product-form-field">

                        <label asp-for="Stock">
                            Остаток на складе
                        </label>

                        <input asp-for="Stock"
                               type="number"
                               step="1"
                               min="0"
                               class="product-input"
                               placeholder="0"
                               inputmode="numeric" />

                        <span class="product-field-hint">
                            Количество доступных единиц.
                        </span>

                        <span asp-validation-for="Stock"
                              class="product-validation"></span>

                    </div>

                </div>

            </div>

            <div class="product-form-section">

                <div class="product-form-section-header">

                    <div>
                        <span class="product-form-kicker">03</span>
                        <h2>Описание</h2>
                    </div>

                    <i class="fas fa-align-left product-form-section-icon"></i>

                </div>


                <div class="product-form-field">

                    <label asp-for="Description">
                        Описание товара
                    </label>

                    <textarea asp-for="Description"
                              class="product-input product-textarea"
                              rows="5"
                              placeholder="Кратко опишите характеристики, назначение или особенности товара..."></textarea>

                    <span asp-validation-for="Description"
                          class="product-validation"></span>

                </div>

            </div>

            <div class="product-form-actions">

                <a asp-action="Index"
                   class="product-form-cancel">
                    Отмена
                </a>

                <button type="submit"
                        class="product-form-submit">

                    <i class="fas fa-check"></i>

                    Сохранить изменения

                </button>

            </div>

        </form>

        <aside class="product-form-aside">

            <div class="product-form-info">

                <span class="product-form-info-kicker">
                    РЕДАКТИРОВАНИЕ
                </span>

                <h2>
                    Данные товара
                </h2>

                <p>
                    Изменения сохранятся в каталоге после отправки формы.
                    Уже созданные коммерческие предложения при этом не изменяются.
                </p>

            </div>


            <div class="product-form-check">

                <div class="product-form-check-icon">
                    <i class="fas fa-rotate"></i>
                </div>

                <div>
                    <strong>Актуальные данные</strong>

                    <span>
                        Поддерживайте цену и остаток товара в актуальном состоянии.
                    </span>
                </div>

            </div>


            <div class="product-form-check">

                <div class="product-form-check-icon">
                    <i class="fas fa-floppy-disk"></i>
                </div>

                <div>
                    <strong>Сохранение</strong>

                    <span>
                        Проверьте изменения перед сохранением карточки товара.
                    </span>
                </div>

            </div>

        </aside>

    </section>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
