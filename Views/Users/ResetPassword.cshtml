@model ContractorHub.Models.User

@{
    ViewData["Title"] = "Сброс пароля";
}

<div class="hub-users-page hub-users-narrow">

    <header class="hub-users-header">
        <div>
            <div class="hub-users-eyebrow">
                <span class="hub-users-eyebrow-dot"></span>
                Безопасность
            </div>
            <h1>Сброс пароля</h1>
            <p>Установите новый пароль для сотрудника <strong>@Model.FullName</strong>.</p>
        </div>
        <a asp-action="Index" class="hub-users-secondary-action"><i class="fas fa-arrow-left"></i> К сотрудникам</a>
    </header>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
    {
        <div class="hub-users-alert hub-users-alert-error">
            <i class="fas fa-circle-exclamation"></i>
            <span>@ViewBag.Error</span>
        </div>
    }

    <section class="hub-users-form-panel">
        <div class="hub-users-panel-header">
            <div>
                <span class="hub-users-panel-kicker">Безопасность учётной записи</span>
                <h2>Новый пароль</h2>
            </div>
            <span class="hub-users-form-index">01</span>
        </div>

        <div class="hub-users-user-summary">
            <span class="hub-users-avatar"><i class="fas fa-user"></i></span>
            <div>
                <strong>@Model.FullName</strong>
                <span>@Model.Username · @(Model.Role switch { "Administrator" => "Администратор", "Manager" => "Менеджер", "Accountant" => "Бухгалтер", _ => Model.Role })</span>
            </div>
        </div>

        <form asp-action="ResetPassword" method="post" class="hub-users-form" id="resetPasswordForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="hub-users-field">
                <label for="newPassword">Новый пароль <span>*</span></label>
                <div class="hub-users-input">
                    <i class="fas fa-lock"></i>
                    <input id="newPassword" name="newPassword" type="password"
                           minlength="8" autocomplete="new-password"
                           placeholder="Введите новый пароль" required />
                    <button type="button" class="hub-users-password-toggle"
                            onclick="togglePassword('newPassword', this)"
                            title="Показать пароль"
                            aria-label="Показать пароль">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="hub-users-field">
                <label for="confirmPassword">Повторите пароль <span>*</span></label>
                <div class="hub-users-input">
                    <i class="fas fa-lock"></i>
                    <input id="confirmPassword" name="confirmPassword" type="password"
                           minlength="8" autocomplete="new-password"
                           placeholder="Повторите новый пароль" required />
                </div>
            </div>

            <div class="hub-users-password-rules">
                <i class="fas fa-shield-halved"></i>
                <div>
                    <strong>Требования к паролю</strong>
                    <span>Минимум 8 символов, заглавная и строчная буква, а также хотя бы одна цифра.</span>
                </div>
            </div>

            <div class="hub-users-form-divider"></div>

            <div class="hub-users-form-actions">
                <a asp-action="Index" class="hub-users-secondary-action">Отмена</a>
                <button type="submit" class="hub-users-primary-action">
                    <i class="fas fa-key"></i>
                    Установить новый пароль
                </button>
            </div>
        </form>
    </section>
</div>

<script>
    function togglePassword(id, button) {
        const input = document.getElementById(id);
        const icon = button.querySelector("i");
        const visible = input.type === "password";
        input.type = visible ? "text" : "password";
        icon.classList.toggle("fa-eye", !visible);
        icon.classList.toggle("fa-eye-slash", visible);
        button.setAttribute("aria-label", visible ? "Скрыть пароль" : "Показать пароль");
    }

    document.getElementById("resetPasswordForm").addEventListener("submit", function (event) {
        const password = document.getElementById("newPassword");
        const confirm = document.getElementById("confirmPassword");

        if (password.value !== confirm.value) {
            event.preventDefault();
            confirm.setCustomValidity("Пароли не совпадают.");
            confirm.reportValidity();
        } else {
            confirm.setCustomValidity("");
        }
    });
</script>
